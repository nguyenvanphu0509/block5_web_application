<%- include('../partials/head') %>
<main id="main" class="shell page-main"><a class="back-link" href="/dishes">← Trở lại thực đơn</a><div class="dish-detail"><figure class="detail-image image-fallback"><img src="<%= dish.imagePath || '/images/noodles.svg' %>" alt="Minh họa <%= dish.name %>" width="600" height="600"></figure><section><span class="section-badge"><%= dish.category || 'Ẩm thực Việt' %></span><h1><%= dish.name %></h1><% if (dish.restaurant) { %><p><a href="/restaurants/<%= dish.restaurant.id %>">Tại <%= dish.restaurant.name %> ↗</a></p><% } %><p class="detail-description"><%= dish.description || 'Chưa có mô tả cho món này.' %></p><p class="detail-price"><%= money(dish.price) %><% if (!dish.priceIsDemo) { %> <small><%= dish.price == null ? 'GIÁ CHƯA XÁC NHẬN' : 'GIÁ THAM KHẢO' %></small><% } %></p><span class="availability <%= dish.available ? '' : 'unavailable' %>"><span class="status-dot"></span><%= dish.available ? 'Đang phục vụ' : 'Tạm hết' %></span><div class="recipe-info"><h2>Đầu bếp & nguyên liệu</h2><div class="recipe-chef"><span class="recipe-label">Đầu bếp</span><strong><%= dish.chef ? dish.chef.name : 'Chưa gắn đầu bếp.' %></strong></div><div class="recipe-ingredients"><span class="recipe-label">Nguyên liệu</span><% if (dish.ingredients?.length) { %><ul class="ingredient-tags"><% dish.ingredients.forEach(link => { %><li><a href="/dishes?ingredientId=<%= link.ingredientId %>"><%= link.ingredient.name %></a></li><% }) %></ul><% } else { %><p class="recipe-empty">Chưa có nguyên liệu.</p><% } %></div></div><dl class="record-meta"><div><dt>Mã món</dt><dd>#<%= dish.id %></dd></div><div><dt>Ngày tạo</dt><dd><%= dateLabel(dish.createdAt) %></dd></div></dl><a class="button outline" href="/dishes">Khám phá thêm món ăn ↗</a></section></div></main>
<%- include('../partials/footer') %>
