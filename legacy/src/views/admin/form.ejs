<%- include('../partials/head') %>
<main id="main" class="shell page-main admin-main"><%- include('../partials/admin-nav') %>
<div class="form-card"><a class="back-link" href="<%= base %>">← Về danh sách</a><h2><%= id ? 'Một chút điều chỉnh' : 'Thêm một câu chuyện mới' %></h2><p class="muted">Các trường có dấu * là bắt buộc.</p>
<% if (Object.keys(errors).length) { %><div class="error-summary" role="alert"><strong>Chưa thể lưu. Kiểm tra các trường sau:</strong><ul><% Object.entries(errors).forEach(([field, error]) => { %><li><a href="#<%= field %>"><%= error %></a></li><% }) %></ul></div><% } %>
<form method="POST" enctype="<%= ['dishes','restaurants'].includes(resource) ? 'multipart/form-data' : 'application/x-www-form-urlencoded' %>" action="<%= id ? `${base}/${id}?_method=PATCH` : base %>">
<% if (resource !== 'dishes') { %><div class="field"><label class="checkbox-label"><input type="checkbox" name="isDemo" value="true" <%= values.isDemo ? 'checked' : '' %>> Dữ liệu demo / minh họa</label></div><% } %>
<div class="field"><label for="name">Tên <%= config.singular %> *</label><input id="name" name="name" value="<%= values.name ?? '' %>" required maxlength="120" <%= errors.name ? 'aria-invalid=true aria-describedby=name-error' : '' %>><% if (errors.name) { %><p class="field-error" id="name-error"><%= errors.name %></p><% } %></div>
<% if (resource === 'restaurants') { %>
<% [['cuisine','Loại ẩm thực'],['address','Địa chỉ'],['ward','Phường'],['district','Khu vực'],['notableDishes','Món nổi bật (ngăn cách bằng dấu phẩy)'],['michelinUrl','URL hồ sơ Michelin']].forEach(([field,label]) => { %><div class="field"><label for="<%= field %>"><%= label %></label><input id="<%= field %>" name="<%= field %>" value="<%= Array.isArray(values[field]) ? values[field].join(', ') : (values[field] ?? '') %>"><% if(errors[field]) { %><p class="field-error"><%= errors[field] %></p><% } %></div><% }) %>
<%- include('../partials/admin-image-editor') %>
<% } else if (resource === 'dishes') { %>
<div class="field relation-card" data-relation-card><label for="restaurantId">Quán phục vụ</label><select id="restaurantId" name="restaurantId"><option value="">Chưa gắn quán</option><% restaurants.forEach(restaurant => { %><option value="<%= restaurant.id %>" <%= String(values.restaurantId) === String(restaurant.id) ? 'selected' : '' %>><%= restaurant.name %></option><% }) %></select><details class="relation-create" <%= values.newRestaurantName ? 'open' : '' %>><summary>+ Thêm quán mới</summary><div class="relation-create-content"><label for="newRestaurantName">Tên quán mới</label><input id="newRestaurantName" name="newRestaurantName" value="<%= values.newRestaurantName ?? '' %>" placeholder="Tên quán mới" maxlength="120"><p class="image-hint">Nhập tên mới sẽ bỏ lựa chọn có sẵn ở phía trên.</p></div></details><% if(errors.restaurantId) { %><p class="field-error"><%= errors.restaurantId %></p><% } %><% if(errors.newRestaurantName) { %><p class="field-error"><%= errors.newRestaurantName %></p><% } %></div>
<div class="field"><label class="checkbox-label"><input type="checkbox" name="priceUnknown" value="true" <%= values.priceUnknown || (id && values.price == null) ? 'checked' : '' %>> Giá chưa xác nhận (hiển thị “Hỏi quán”)</label></div>
<div class="field"><label class="checkbox-label"><input type="checkbox" name="priceIsDemo" value="true" <%= values.priceIsDemo ? 'checked' : '' %>> Giá demo cho bài tập</label></div>
<div class="field relation-card" data-relation-card><label for="chefId">Đầu bếp phụ trách</label><select id="chefId" name="chefId"><option value="">Chưa gắn đầu bếp</option><% chefs.forEach(chef => { %><option value="<%= chef.id %>" <%= String(values.chefId) === String(chef.id) ? 'selected' : '' %>><%= chef.name %></option><% }) %></select><details class="relation-create" <%= values.newChefName ? 'open' : '' %>><summary>+ Thêm đầu bếp mới</summary><div class="relation-create-content"><label for="newChefName">Tên đầu bếp mới</label><input id="newChefName" name="newChefName" value="<%= values.newChefName ?? '' %>" placeholder="Tên đầu bếp mới" maxlength="120"><p class="image-hint">Nhập tên mới sẽ bỏ lựa chọn có sẵn ở phía trên.</p></div></details><% if(errors.chefId) { %><p class="field-error"><%= errors.chefId %></p><% } %><% if(errors.newChefName) { %><p class="field-error"><%= errors.newChefName %></p><% } %></div>
<fieldset class="field" id="ingredientIds"><legend>Nguyên liệu</legend><div class="ingredient-checkboxes"><% ingredients.forEach(ingredient => { %><label class="checkbox-label"><input type="checkbox" name="ingredientIds" value="<%= ingredient.id %>" <%= (values.ingredientIds || []).includes(String(ingredient.id)) ? 'checked' : '' %>> <%= ingredient.name %> (<%= ingredient.unit %>)</label><% }) %></div><div class="ingredient-create-section"><p class="image-hint">Chọn nhiều nguyên liệu ở trên, hoặc thêm những nguyên liệu còn thiếu bên dưới.</p>
<div data-ingredient-rows>
<% const ingredientNames = Array.isArray(values.newIngredientName) ? values.newIngredientName : [values.newIngredientName || '']; const ingredientUnits = Array.isArray(values.newIngredientUnit) ? values.newIngredientUnit : [values.newIngredientUnit || '']; ingredientNames.forEach((name,index) => { %>
<div class="new-ingredient-row"><div><label for="newIngredientName<%= index %>">Tên nguyên liệu mới</label><input id="newIngredientName<%= index %>" name="newIngredientName" value="<%= name %>" placeholder="Ví dụ: Nấm hương" maxlength="120"></div><div><label for="newIngredientUnit<%= index %>">Đơn vị</label><input id="newIngredientUnit<%= index %>" name="newIngredientUnit" value="<%= ingredientUnits[index] || '' %>" placeholder="g, ml, quả…" maxlength="30"></div><button type="button" class="ingredient-remove" data-remove-ingredient aria-label="Bỏ dòng nguyên liệu">×</button></div>
<% }); %></div><button class="button outline small" type="button" data-add-ingredient>+ Thêm nguyên liệu khác</button><p class="image-hint">Tối đa 20 nguyên liệu mới mỗi lần lưu.</p></div>
<% ['ingredientIds','newIngredientName','newIngredientUnit'].forEach(field => { if(errors[field]) { %><p class="field-error" id="<%= field %>-error"><%= errors[field] %></p><% } }); %>
</fieldset>
<div class="field"><label class="checkbox-label"><input type="checkbox" name="recipeIsDemo" value="true" <%= values.recipeIsDemo ? 'checked' : '' %>> Đầu bếp / công thức là gợi ý demo</label></div>
<div class="field"><label for="description">Mô tả</label><textarea id="description" name="description" rows="5" maxlength="2000" <%= errors.description ? 'aria-invalid=true aria-describedby=description-error' : '' %>><%= values.description ?? '' %></textarea><% if (errors.description) { %><p class="field-error" id="description-error"><%= errors.description %></p><% } %></div>
<div class="form-columns"><div class="field"><label for="price">Giá món (VND)</label><input id="price" name="price" type="number" min="0" max="2147483647" step="1" value="<%= values.price ?? '' %>" <%= errors.price ? 'aria-invalid=true aria-describedby=price-error' : '' %>><% if (errors.price) { %><p class="field-error" id="price-error"><%= errors.price %></p><% } %></div><div class="field"><label for="category">Loại món</label><input id="category" name="category" value="<%= values.category ?? '' %>" maxlength="80" <%= errors.category ? 'aria-invalid=true aria-describedby=category-error' : '' %>><% if (errors.category) { %><p class="field-error" id="category-error"><%= errors.category %></p><% } %></div></div>
<%- include('../partials/admin-image-editor') %>
<div class="field"><label class="checkbox-label" for="available"><input id="available" name="available" type="checkbox" value="true" <%= values.available ? 'checked' : '' %> <%= errors.available ? 'aria-invalid=true aria-describedby=available-error' : '' %>> Đang phục vụ</label><% if (errors.available) { %><p class="field-error" id="available-error"><%= errors.available %></p><% } %></div>
<% } else { const field = resource === 'chefs' ? 'specialty' : 'unit'; const label = resource === 'chefs' ? 'Chuyên môn' : 'Đơn vị'; %><div class="field"><label for="<%= field %>"><%= label %><%= resource === 'ingredients' ? ' *' : '' %></label><input id="<%= field %>" name="<%= field %>" value="<%= values[field] ?? '' %>" maxlength="<%= resource === 'chefs' ? 120 : 30 %>" <%= resource === 'ingredients' ? 'required' : '' %> <%= errors[field] ? `aria-invalid=true aria-describedby=${field}-error` : '' %>><% if (errors[field]) { %><p class="field-error" id="<%= field %>-error"><%= errors[field] %></p><% } %></div><% } %>
<div class="form-actions"><button class="button" type="submit" <%= preview ? 'disabled' : '' %>><%= id ? 'Lưu thay đổi' : 'Thêm bản ghi' %> ↗</button><a class="button outline" href="<%= base %>">Hủy</a></div><% if (preview) { %><p class="source-note">Preview chỉ đọc. Cấu hình .env và chạy npm start để lưu vào database.</p><% } %>
</form></div></main><% if(['dishes','restaurants'].includes(resource)) { %><script src="/js/dish-image-editor.js" defer></script><% } %><% if(resource === 'dishes') { %><script src="/js/admin-relations.js" defer></script><% } %><%- include('../partials/footer') %>
