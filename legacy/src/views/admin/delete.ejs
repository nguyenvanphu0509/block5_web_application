<%- include('../partials/head') %>
<main id="main" class="shell page-main admin-main"><%- include('../partials/admin-nav') %><div class="form-card delete-card"><span class="section-badge">XÁC NHẬN THAO TÁC</span><h2>Xóa “<%= record.name %>”?</h2><p>Bản ghi #<%= record.id %> sẽ bị xóa khỏi database. Thao tác này không thể hoàn tác.</p><form method="POST" action="<%= base %>/<%= record.id %>?_method=DELETE"><div class="form-actions"><button class="button danger" type="submit" <%= preview ? 'disabled' : '' %>>Xác nhận xóa</button><a class="button outline" href="<%= base %>/<%= record.id %>">Giữ lại bản ghi</a></div></form><% if (preview) { %><p class="source-note">Chức năng xóa bị khóa trong preview chỉ đọc.</p><% } %></div></main><%- include('../partials/footer') %>
