<%- include('../partials/head') %>
<main id="main" class="shell page-main admin-main"><%- include('../partials/admin-nav') %><% if (message) { %><p class="success-message" role="status"><%= message %></p><% } %><div class="form-card"><a class="back-link" href="<%= base %>">← Về danh sách</a><h2><%= record.name %></h2><dl class="record-meta"><div><dt>ID</dt><dd>#<%= record.id %></dd></div><% config.columns.forEach(([field, label]) => { %><div><dt><%= label %></dt><dd><%= field === 'price' ? money(record.price) : field === 'available' ? (record.available ? 'Đang phục vụ' : 'Tạm hết') : record[field] || '—' %></dd></div><% }) %><% if (resource === 'dishes') { %><div><dt>Giá demo</dt><dd><%= record.priceIsDemo ? 'Có' : 'Không' %></dd></div><div><dt>Quán phục vụ</dt><dd><%= record.restaurant?.name || 'Chưa gắn' %></dd></div><div><dt>Đầu bếp</dt><dd><%= record.chef?.name || 'Chưa gắn' %></dd></div><div><dt>Nguyên liệu</dt><dd><%= (record.ingredients || []).map(link => link.ingredient.name).join(', ') || 'Chưa gắn' %></dd></div><div><dt>Mô tả</dt><dd><%= record.description || '—' %></dd></div><div><dt>Ảnh minh họa</dt><dd><%= record.imagePath || 'Mặc định' %></dd></div><% } %><div><dt>Ngày tạo</dt><dd><%= dateLabel(record.createdAt) %></dd></div></dl><div class="form-actions save-navigation"><a class="button" href="<%= base %>"><%= resource === 'dishes' ? 'Danh sách món ăn' : resource === 'restaurants' ? 'Danh sách nhà hàng' : `Danh sách ${config.label.toLowerCase()}` %> ↗</a><% if(resource === 'dishes' || resource === 'restaurants') { %><a class="button outline" href="<%= resource === 'dishes' ? '/dishes' : '/#destinations' %>"><%= resource === 'dishes' ? 'Xem tất cả món ăn' : 'Xem các nhà hàng' %> ↗</a><% } %></div><div class="form-actions"><a class="button outline" href="<%= base %>/<%= record.id %>/edit">Sửa bản ghi ↗</a><a class="button outline danger-link" href="<%= base %>/<%= record.id %>/delete">Xóa</a><% if (resource === 'dishes') { %><a class="back-link" href="/dishes/<%= record.id %>">Xem trang khách ↗</a><% } %></div></div></main>
<%- include('../partials/footer') %>
