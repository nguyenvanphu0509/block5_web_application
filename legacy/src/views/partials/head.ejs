<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Ẩm thực Việt — khám phá ẩm thực Sài Gòn. Ứng dụng SSR demo với Express, EJS và Supabase.">
  <title><%= title %> · Ẩm thực Việt</title>
  <link rel="icon" href="/images/greens.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/motion.css">
  <link rel="stylesheet" href="/css/spa.css"><link rel="stylesheet" href="/css/ssr.css">
  <script src="/js/image-fallback.js" defer></script><script src="/js/motion.js" defer></script>
  <script src="/js/restaurant-photos.js" defer></script>
  <script src="/js/account-menu.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Đến nội dung chính</a>
<% const accountPage=['/login','/register','/activate','/activate/resend','/forgot','/reset'].includes(currentPath); if(!accountPage) { %><header class="site-header shell">
  <a class="brand" href="/" aria-label="Ẩm thực Việt, trang chủ"><span class="brand-logo"><img src="/images/logo.png" alt="" width="2048" height="2048"></span><span>ẨM THỰC VIỆT<span class="brand-sub">TINH HOA HƯƠNG VỊ</span></span></a>
  <nav class="desktop-nav" aria-label="Điều hướng chính">
    <a href="/#destinations">Khám phá</a><a href="/dishes" <%= currentPath.startsWith('/dishes') ? 'aria-current=page' : '' %>>Món ăn</a><a href="/#journey">Cẩm nang</a><a href="/#about">Về chúng tôi</a>
  </nav>
  <div class="header-actions">
    <% if (user) { const displayName = user.name?.trim() || user.email; const initial = Array.from(displayName)[0].toLocaleUpperCase('vi'); %>
    <details class="account-menu" data-account-menu>
      <summary class="account-avatar" aria-label="Tài khoản của <%= displayName %>" aria-expanded="false" aria-controls="account-panel"><span aria-hidden="true"><%= initial %></span></summary>
      <div class="account-panel" id="account-panel">
        <div class="account-profile">
          <span class="account-avatar account-avatar-preview" aria-hidden="true"><%= initial %></span>
          <div class="account-identity"><span class="account-caption">Tài khoản của bạn</span><strong><%= user.name?.trim() || 'Thành viên' %></strong><span class="account-email"><%= user.email %></span></div>
        </div>
        <form class="account-logout-form" method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="account-logout" type="submit"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5H5v14h4M14 8l4 4-4 4M9 12h9"/></svg>Đăng xuất</button>
        </form>
      </div>
    </details>
    <% } else { %><a href="/login">Đăng nhập</a><% } %>
    <a class="button small" href="/dishes">Khám phá món ăn <span aria-hidden="true">↗</span></a>
  </div>
  <details class="mobile-menu"><summary aria-label="Mở điều hướng">☰</summary><nav aria-label="Điều hướng mobile"><a href="/#destinations">Khám phá</a><a href="/dishes">Món ăn</a><a href="/#journey">Cẩm nang</a><a href="/#about">Về chúng tôi</a><a href="/admin">Quản lý</a><% if(!user){ %><a href="/login">Đăng nhập</a><% } %></nav></details>
</header><% } %>
<% if (preview) { %><aside class="preview-note shell" role="status"><span class="status-dot"></span> Chế độ chỉ đọc · dữ liệu từ Supabase; thao tác lưu bị khóa.</aside><% } %>
