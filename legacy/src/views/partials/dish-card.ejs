<article class="dish-card">
  <a class="dish-image illustration image-fallback" href="/dishes/<%= dish.id %>"><img src="<%= dish.imagePath || '/images/noodles.svg' %>" alt="Ảnh cho <%= dish.name %>" width="600" height="600" loading="lazy"></a>
  <div class="dish-card-content"><div class="eyebrow"><%= dish.category || 'Ẩm thực Việt' %></div><h2><a href="/dishes/<%= dish.id %>"><%= dish.name %></a></h2><% if (dish.restaurant) { %><p class="dish-restaurant"><a href="/restaurants/<%= dish.restaurant.id %>"><%= dish.restaurant.name %></a><% if(dish.restaurant.district) { %> · <%= dish.restaurant.district %><% } %></p><% } %><p class="card-description"><%= dish.description || 'Khám phá thêm về món ăn này.' %></p><div class="card-bottom"><strong><%= money(dish.price) %><% if(dish.priceIsDemo) { %><small class="demo-price">Giá demo</small><% } %></strong><span class="availability <%= dish.available ? '' : 'unavailable' %>"><span class="status-dot"></span><%= dish.available ? 'Đang phục vụ' : 'Tạm hết' %></span></div></div>
</article>
