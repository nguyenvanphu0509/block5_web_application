<%- include('../partials/head') %>
<main id="main" class="shell page-main admin-main"><%- include('../partials/admin-nav') %>
<% if (message) { %><p class="success-message" role="status"><%= message %></p><% } %>
<div class="admin-toolbar"><span><%= records.length %> bản ghi</span><a class="button small" href="<%= base %>/new">+ Thêm <%= config.singular %></a></div>
<% if (!records.length) { %><div class="empty-state"><h2>Chưa có <%= config.singular %></h2><p>Thêm bản ghi đầu tiên để bắt đầu.</p></div><% } else { %>
<div class="table-scroll"><table><caption class="sr-only">Danh sách <%= config.label %></caption><thead><tr><th scope="col">ID</th><% config.columns.forEach(([field, label]) => { %><th scope="col"><%= label %></th><% }) %><th scope="col">Thao tác</th></tr></thead><tbody><% records.forEach(record => { %><tr><td class="muted">#<%= record.id %></td><% config.columns.forEach(([field]) => { %><td><% if (field === 'name') { %><a class="record-name" href="<%= base %>/<%= record.id %>"><%= record.name %></a><% } else if (field === 'price') { %><%= money(record.price) %><% } else if (field === 'available') { %><span class="availability <%= record.available ? '' : 'unavailable' %>"><%= record.available ? 'Đang phục vụ' : 'Tạm hết' %></span><% } else { %><%= record[field] || '—' %><% } %></td><% }) %><td><div class="table-actions"><a href="<%= base %>/<%= record.id %>">Xem</a><a href="<%= base %>/<%= record.id %>/edit">Sửa</a><a class="danger-link" href="<%= base %>/<%= record.id %>/delete">Xóa</a></div></td></tr><% }) %></tbody></table></div><% } %>
</main><%- include('../partials/footer') %>
