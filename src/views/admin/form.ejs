<%- include('../partials/head') %>
<main id="main" class="shell page-main admin-main"><%- include('../partials/admin-nav') %>
<div class="form-card"><a class="back-link" href="<%= base %>">← Về danh sách</a><h2><%= id ? 'Một chút điều chỉnh' : 'Thêm một câu chuyện mới' %></h2><p class="muted">Các trường có dấu * là bắt buộc.</p>
<% if (Object.keys(errors).length) { %><div class="error-summary" role="alert"><strong>Chưa thể lưu. Kiểm tra các trường sau:</strong><ul><% Object.entries(errors).forEach(([field, error]) => { %><li><a href="#<%= field %>"><%= error %></a></li><% }) %></ul></div><% } %>
<form method="POST" enctype="multipart/form-data" action="<%= id ? `${base}/${id}?_method=PATCH` : base %>">
<div class="field"><label for="name">Tên <%= config.singular %> *</label><input id="name" name="name" value="<%= values.name ?? '' %>" required maxlength="120" <%= errors.name ? 'aria-invalid=true aria-describedby=name-error' : '' %>><% if (errors.name) { %><p class="field-error" id="name-error"><%= errors.name %></p><% } %></div>
<% if (resource === 'dishes') { %>
<div class="field"><label for="description">Mô tả</label><textarea id="description" name="description" rows="5" maxlength="2000" <%= errors.description ? 'aria-invalid=true aria-describedby=description-error' : '' %>><%= values.description ?? '' %></textarea><% if (errors.description) { %><p class="field-error" id="description-error"><%= errors.description %></p><% } %></div>
<div class="form-columns"><div class="field"><label for="price">Giá demo (VND) *</label><input id="price" name="price" type="number" min="0" max="2147483647" step="1" value="<%= values.price ?? '' %>" required <%= errors.price ? 'aria-invalid=true aria-describedby=price-error' : '' %>><% if (errors.price) { %><p class="field-error" id="price-error"><%= errors.price %></p><% } %></div><div class="field"><label for="category">Loại món</label><input id="category" name="category" value="<%= values.category ?? '' %>" maxlength="80" <%= errors.category ? 'aria-invalid=true aria-describedby=category-error' : '' %>><% if (errors.category) { %><p class="field-error" id="category-error"><%= errors.category %></p><% } %></div></div>
<div class="field"><label for="imagePath">Ảnh minh họa</label><select id="imagePath" name="imagePath" <%= errors.imagePath ? 'aria-invalid=true aria-describedby=imagePath-error' : '' %>><option value="">Ảnh mặc định</option><% imageChoices.forEach(image => { %><option value="<%= image.path %>" <%= values.imagePath === image.path ? 'selected' : '' %>><%= image.label %></option><% }) %></select><% if (errors.imagePath) { %><p class="field-error" id="imagePath-error"><%= errors.imagePath %></p><% } %></div>
<div class="field"><label for="imageFile">Hoặc tải ảnh lên</label><input id="imageFile" name="imageFile" type="file" accept="image/jpeg,image/png,image/webp"><p class="muted">JPG, PNG hoặc WebP; tối đa 5 MB.</p></div>
<div class="field"><label class="checkbox-label" for="available"><input id="available" name="available" type="checkbox" value="true" <%= values.available ? 'checked' : '' %> <%= errors.available ? 'aria-invalid=true aria-describedby=available-error' : '' %>> Đang phục vụ</label><% if (errors.available) { %><p class="field-error" id="available-error"><%= errors.available %></p><% } %></div>
<% } else { const field = resource === 'chefs' ? 'specialty' : 'unit'; const label = resource === 'chefs' ? 'Chuyên môn' : 'Đơn vị'; %><div class="field"><label for="<%= field %>"><%= label %><%= resource === 'ingredients' ? ' *' : '' %></label><input id="<%= field %>" name="<%= field %>" value="<%= values[field] ?? '' %>" maxlength="<%= resource === 'chefs' ? 120 : 30 %>" <%= resource === 'ingredients' ? 'required' : '' %> <%= errors[field] ? `aria-invalid=true aria-describedby=${field}-error` : '' %>><% if (errors[field]) { %><p class="field-error" id="<%= field %>-error"><%= errors[field] %></p><% } %></div><% } %>
<div class="form-actions"><button class="button" type="submit" <%= preview ? 'disabled' : '' %>><%= id ? 'Lưu thay đổi' : 'Thêm bản ghi' %> ↗</button><a class="button outline" href="<%= base %>">Hủy</a></div><% if (preview) { %><p class="source-note">Preview chỉ đọc. Cấu hình .env và chạy npm start để lưu vào database.</p><% } %>
</form></div></main><%- include('../partials/footer') %>
