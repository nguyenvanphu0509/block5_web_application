<%- include('../partials/head') %>
<main id="main" class="shell page-main admin-main"><%- include('../partials/admin-nav') %><% if (message) { %><p class="success-message" role="status"><%= message %></p><% } %><div class="form-card"><a class="back-link" href="<%= base %>">← Về danh sách</a><h2><%= record.name %></h2><dl class="record-meta"><div><dt>ID</dt><dd>#<%= record.id %></dd></div><% config.columns.forEach(([field, label]) => { %><div><dt><%= label %></dt><dd><%= field === 'price' ? money(record.price) : field === 'available' ? (record.available ? 'Đang phục vụ' : 'Tạm hết') : record[field] || '—' %></dd></div><% }) %><% if (resource === 'dishes') { %><div><dt>Mô tả</dt><dd><%= record.description || '—' %></dd></div><div><dt>Ảnh minh họa</dt><dd><%= record.imagePath || 'Mặc định' %></dd></div><% } %><div><dt>Ngày tạo</dt><dd><%= dateLabel(record.createdAt) %></dd></div></dl><div class="form-actions"><a class="button" href="<%= base %>/<%= record.id %>/edit">Sửa bản ghi ↗</a><a class="button outline danger-link" href="<%= base %>/<%= record.id %>/delete">Xóa</a><% if (resource === 'dishes') { %><a class="back-link" href="/dishes/<%= record.id %>">Xem trang khách ↗</a><% } %></div></div></main>
<%- include('../partials/footer') %>
