<%- include('../partials/head') %>
<main id="main" class="shell page-main"><a class="back-link" href="/dishes">← Trở lại thực đơn</a><div class="dish-detail"><figure class="detail-image image-fallback"><img src="<%= dish.imagePath || '/images/noodles.svg' %>" alt="Minh họa <%= dish.name %>" width="600" height="600"><figcaption>Minh họa tự tạo · Không phải ảnh món thật</figcaption></figure><section><span class="section-badge"><%= dish.category || 'Ẩm thực Việt' %></span><h1><%= dish.name %></h1><p class="detail-description"><%= dish.description || 'Chưa có mô tả cho món này.' %></p><p class="detail-price"><%= money(dish.price) %> <small>GIÁ DEMO</small></p><span class="availability <%= dish.available ? '' : 'unavailable' %>"><span class="status-dot"></span><%= dish.available ? 'Đang phục vụ' : 'Tạm hết' %></span><dl class="record-meta"><div><dt>Mã món</dt><dd>#<%= dish.id %></dd></div><div><dt>Ngày tạo</dt><dd><%= dateLabel(dish.createdAt) %></dd></div></dl><a class="button outline" href="/dishes">Khám phá thêm món ăn ↗</a></section></div></main>
<%- include('../partials/footer') %>
