<%- include('../partials/head') %>
<main id="main">
  <section class="hero">
    <div class="hero-landscape landscape"><img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2200&q=85" alt="Phong cảnh thiên nhiên minh họa cho hành trình khám phá" width="2200" height="1200" fetchpriority="high"></div>
    <div class="hero-content shell">
      <div class="hero-tag"><span class="country-pill"><span class="flag" aria-hidden="true">★</span> VIỆT NAM · SÀI GÒN</span><span class="italic">A taste of somewhere special</span></div>
      <div class="hero-photo-group" aria-label="Ba hương vị nổi bật">
        <% for (let i = 0; i < 3; i++) { const dish = featured[i]; %>
        <a class="hero-photo <%= i === 1 ? 'center-photo' : '' %> image-fallback" href="<%= dish ? `/dishes/${dish.id}` : '/dishes' %>"><img src="<%= dish?.imagePath || ['/images/noodles.svg', '/images/rice.svg', '/images/rolls.svg'][i] %>" alt="<%= dish ? `Minh họa ${dish.name}` : 'Minh họa ẩm thực Việt' %>" width="600" height="600"><span><%= dish?.name || 'Một hương vị mới' %><small>SAIGON COLLECTION · 0<%= i + 1 %></small></span></a>
        <% } %>
      </div>
      <p class="eyebrow hero-eyebrow">CHẠM VÀO HƯƠNG VỊ ĐỊA PHƯƠNG</p>
      <h1>Khám phá tinh hoa<br>ẩm thực <em>Sài Gòn</em></h1>
      <p class="hero-description">Từ góc phố thân quen đến những trải nghiệm mới mẻ.<br>Mỗi món ăn là một câu chuyện, mỗi hành trình là một hương vị.</p>
      <div class="button-row"><a class="button" href="/dishes">Xem thực đơn <span aria-hidden="true">↗</span></a><a class="button outline" href="#destinations">Khám phá địa điểm <span aria-hidden="true">↓</span></a></div>
      <div class="hero-footnote"><span class="little-leaf" aria-hidden="true">✳</span> Được tạo nên từ cảm hứng ẩm thực Việt</div>
    </div>
  </section>

  <section class="section shell journey" id="journey">
    <div class="section-heading"><span class="section-badge">✳ &nbsp; HƯƠNG VỊ & CẢM HỨNG</span><h2>Một hành trình qua <em>hương vị</em></h2><p>Chậm lại một chút. Khám phá những điều giản dị làm nên bản sắc một thành phố.</p></div>
    <figure class="journey-showcase image-fallback"><img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=1800&q=85" alt="Ảnh minh họa một bữa ăn nhiều rau xanh" width="1800" height="950" loading="lazy"><figcaption><span class="eyebrow">THE ART OF SLOW DISCOVERY</span><h3>Hương vị nhỏ.<br>Kỷ niệm dài.</h3><span>Ảnh minh họa · Một góc nhìn về ẩm thực</span></figcaption><span class="showcase-number" aria-hidden="true">01 / STORIES</span></figure>
    <div class="features"><article><span class="feature-icon" aria-hidden="true">✳</span><h3>Hương vị đa dạng</h3><p>Từ món nước đến những chiếc bánh, khám phá thực đơn đầy cảm hứng Việt.</p></article><article><span class="feature-icon" aria-hidden="true">⌖</span><h3>Khám phá địa phương</h3><p>Tìm cảm hứng từ các địa điểm tại Sài Gòn trong dữ liệu tham khảo Michelin.</p></article><article><span class="feature-icon" aria-hidden="true">↗</span><h3>Dễ dàng tìm món</h3><p>Tìm theo tên, xem chi tiết và chọn hương vị bạn muốn khám phá hôm nay.</p></article></div>
  </section>

  <section class="section destinations-section" id="destinations"><div class="shell">
    <div class="section-heading"><span class="section-badge">⌖ &nbsp; SAIGON, THROUGH A LOCAL LENS</span><h2>Những địa điểm <em>đáng khám phá</em></h2><p>36 địa điểm từ dữ liệu tham khảo bạn cung cấp. Một khởi đầu cho hành trình của riêng bạn.</p></div>
    <form class="search-form" method="GET" action="/#destinations"><label class="sr-only" for="destination-search">Tìm tên nhà hàng</label><input id="destination-search" name="destinationQ" value="<%= state.destinationQ %>" maxlength="120" placeholder="Bạn muốn khám phá địa điểm nào?"><input type="hidden" name="reviewTab" value="<%= state.reviewTab %>"><input type="hidden" name="reviewPage" value="<%= state.reviewPage %>"><button class="button small" type="submit">Tìm địa điểm ↗</button></form>
    <div class="catalog-toolbar"><span><%= destinationCount %> địa điểm <%= state.destinationQ ? `cho “${state.destinationQ}”` : 'tham khảo' %></span><span>HO CHI MINH CITY, VIETNAM</span></div>
    <% if (!restaurants.length) { %><div class="empty-state"><h3>Chưa tìm thấy địa điểm</h3><p>Thử tên khác hoặc quay lại danh sách đầu tiên.</p><a class="button outline" href="<%= href({ destinationQ: '', destinationPage: 1 }, 'destinations') %>">Xem tất cả địa điểm</a></div><% } %>
    <div class="restaurant-grid"><% restaurants.forEach((restaurant) => { %>
      <article class="restaurant-card"><a class="restaurant-image image-fallback" href="<%= restaurant.michelin_url %>" target="_blank" rel="noopener noreferrer"><img src="<%= restaurant.image_url %>" alt="Ảnh từ hồ sơ Michelin của <%= restaurant.name %>" width="500" height="500" loading="lazy"><span class="photo-badge"><%= restaurant.photo_type === 'starter' ? 'Ảnh món khai vị' : 'Ảnh món chính' %></span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="restaurant-content"><div class="eyebrow"><%= restaurant.cuisine %></div><h3><a href="<%= restaurant.michelin_url %>" target="_blank" rel="noopener noreferrer"><%= restaurant.name %></a></h3><div class="restaurant-bottom"><span><%= restaurantPrice(restaurant) %></span><a href="<%= restaurant.michelin_url %>" target="_blank" rel="noopener noreferrer">MICHELIN ↗</a></div></div></article>
    <% }) %></div>
    <nav class="pagination" aria-label="Phân trang địa điểm"><% if (state.destinationPage > 1) { %><a class="circle-button" aria-label="Trang địa điểm trước" href="<%= href({ destinationPage: state.destinationPage - 1 }, 'destinations') %>">←</a><% } %><span>Trang <%= state.destinationPage %> / <%= Math.max(1, destinationPages) %></span><% if (state.destinationPage < destinationPages) { %><a class="circle-button" aria-label="Trang địa điểm tiếp" href="<%= href({ destinationPage: state.destinationPage + 1 }, 'destinations') %>">→</a><% } %></nav>
    <p class="source-note">Khoảng giá tham khảo từ dữ liệu cung cấp, không phải giá từng món. Ảnh thuộc hồ sơ nhà hàng; không xác định tên món từ ảnh. Nguồn: MICHELIN Guide.</p>
  </div></section>

  <section class="section shell reviews" id="reviews"><div class="section-heading"><span class="section-badge">✧ &nbsp; NHỮNG CÂU CHUYỆN NHỎ</span><h2>Cảm hứng từ những <em>hành trình</em></h2><p>Nội dung minh họa cho bài tập · Nhân vật và nhận xét hư cấu.</p></div>
    <nav class="review-tabs" aria-label="Loại nội dung cảm hứng"><a class="<%= state.reviewTab === 'text' ? 'active' : '' %>" href="<%= href({ reviewTab: 'text' }, 'reviews') %>" <%= state.reviewTab === 'text' ? 'aria-current=page' : '' %>>Nhận xét</a><a class="<%= state.reviewTab === 'gallery' ? 'active' : '' %>" href="<%= href({ reviewTab: 'gallery' }, 'reviews') %>" <%= state.reviewTab === 'gallery' ? 'aria-current=page' : '' %>>Hành trình ảnh</a></nav>
    <% if (!reviews.length) { %><div class="empty-state"><h3>Hành trình đang chờ bạn</h3><a href="<%= href({ reviewPage: 1 }, 'reviews') %>">Về trang đầu</a></div><% } %>
    <div class="review-grid"><% reviews.forEach((review, index) => { %><article class="review-card <%= state.reviewTab === 'gallery' ? 'gallery-mode' : '' %>"><span class="stars" aria-label="5 sao minh họa">★★★★★</span><% if (state.reviewTab === 'text') { %><blockquote><%= review.text %></blockquote><% } else { %><h3>Một ngày, nhiều hương vị</h3><p>Gallery minh họa · không phải ảnh chuyến đi thật.</p><% } %><div class="mini-gallery"><% ['/images/noodles.svg', '/images/rolls.svg', '/images/rice.svg'].forEach(image => { %><img src="<%= image %>" alt="Minh họa ẩm thực trong hành trình demo" width="600" height="600" loading="lazy"><% }) %></div><div class="review-person"><span class="avatar"><%= review.initials %></span><div><strong><%= review.name %></strong><span><%= review.location %> · Nhân vật minh họa</span></div><span class="quote-mark" aria-hidden="true">”</span></div></article><% }) %></div>
    <nav class="pagination" aria-label="Phân trang cảm hứng"><% if (state.reviewPage > 1) { %><a class="circle-button" aria-label="Cảm hứng trước" href="<%= href({ reviewPage: state.reviewPage - 1 }, 'reviews') %>">←</a><% } %><span><%= state.reviewPage %> / <%= reviewPages %></span><% if (state.reviewPage < reviewPages) { %><a class="circle-button" aria-label="Cảm hứng tiếp theo" href="<%= href({ reviewPage: state.reviewPage + 1 }, 'reviews') %>">→</a><% } %></nav>
  </section>

  <section class="final-cta" id="about"><div class="shell final-content"><div class="cta-photo-group" aria-label="Minh họa hương vị Việt"><img src="/images/rolls.svg" alt="Minh họa món cuốn" width="600" height="600" loading="lazy"><img src="/images/greens.svg" alt="Minh họa rau xanh" width="600" height="600" loading="lazy"><img src="/images/rice.svg" alt="Minh họa món cơm" width="600" height="600" loading="lazy"></div><span class="section-badge">A LITTLE CURIOSITY. A NEW FLAVOUR.</span><h2>Sẵn sàng khám phá<br><em>hương vị tiếp theo?</em></h2><p>Hãy để một món ăn mới mở ra một câu chuyện mới.</p><a class="button" href="/dishes">Khám phá thực đơn <span aria-hidden="true">↗</span></a><p class="cta-note">Block5 Kitchen · Một dự án học tập về SSR và ẩm thực.</p></div><div class="cta-landscape landscape"><img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2200&q=85" alt="Phong cảnh núi xanh minh họa" width="2200" height="1200" loading="lazy"></div></section>
</main>
<%- include('../partials/footer') %>
