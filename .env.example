# Session pooler, port 5432. Encode special characters in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres"
PORT=3000
APP_ORIGIN=http://localhost:3000
# Read-only local preview without a database. No writes or persistent CRUD.
PREVIEW_MODE=false
# Supabase Storage: create a public bucket named dish-images in the dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=dish-images
# Optional integration tests: a separate, disposable PostgreSQL database/schema.
TEST_DATABASE_URL=
