generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int?
  priceIsDemo Boolean @default(false)
  recipeIsDemo Boolean @default(false)
  category    String?
  available   Boolean  @default(true)
  imagePath   String?
  priceSymbol String?
  priceLabel  String?
  priceMinVnd Int?
  priceMaxVnd Int?
  photoType   String?
  michelinUrl String?
  searchText  String   @default("")
  importKey   String?  @unique
  restaurantId Int?
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  chefId Int?
  chef Chef? @relation(fields: [chefId], references: [id], onDelete: SetNull)
  ingredients DishIngredient[]
  createdAt   DateTime @default(now())

  @@map("dishes")
  @@index([restaurantId])
  @@index([chefId])
}

model Restaurant {
  id           Int      @id @default(autoincrement())
  name         String
  isDemo       Boolean @default(false)
  catalogKey   String? @unique
  address      String?
  ward         String?
  district     String?
  cuisine      String
  notableDishes String[] @default([])
  imagePath    String?
  photoType    String?
  priceMinVnd  Int?
  priceMaxVnd  Int?
  michelinUrl  String?  @unique
  searchText   String   @default("")
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  dishes       Dish[]

  @@map("restaurants")
}

model Story {
  id Int @id @default(autoincrement())
  name String
  location String
  initials String
  text String
  @@map("stories")
}

model RestaurantImportArchive {
  legacyId Int @id
  record Json
  archivedAt DateTime @default(now())
  @@map("restaurant_import_archive")
}

model Chef {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String?
  isDemo Boolean @default(false)
  catalogKey String? @unique
  dishes Dish[]
  createdAt DateTime @default(now())

  @@map("chefs")
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String
  isDemo Boolean @default(false)
  catalogKey String? @unique
  dishes DishIngredient[]
  createdAt DateTime @default(now())

  @@map("ingredients")
}

model DishIngredient {
  dishId Int
  ingredientId Int
  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([dishId, ingredientId])
  @@index([ingredientId])
  @@map("dish_ingredients")
}
