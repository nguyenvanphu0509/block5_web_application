# Session pooler, port 5432. Encode special characters in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres"
PORT=3000
APP_ORIGIN=http://localhost:3000
# Block 6: API and SPA have separate origins. APP_ORIGIN above is for legacy SSR.
API_PORT=3000
SPA_ORIGIN=http://localhost:5173
# Read-only preview still reads Supabase and requires DATABASE_URL.
PREVIEW_MODE=false
# Supabase Storage: create a public bucket named dish-images in the dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=dish-images
# Optional integration tests: a separate, disposable PostgreSQL database/schema.
TEST_DATABASE_URL=

# SPA API authentication; generate a random secret of at least 32 bytes.
JWT_SECRET=
# Defaults to JWT_SECRET. To share SSR OTP challenges, use SSR_SESSION_SECRET.
AUTH_CHALLENGE_SECRET=
# Defaults to DATABASE_URL; use the SSR auth DB to share accounts.
AUTH_DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
# Optional: auth:seed creates an active admin without changing existing accounts.
API_SEED_EMAIL=
API_SEED_PASSWORD=
