# Session pooler, port 5432. Encode special characters in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres"
PORT=3000
APP_ORIGIN=http://localhost:3000
# Block 6: API and SPA have separate origins. APP_ORIGIN above is for legacy SSR.
API_PORT=3000
SPA_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-server-secret
JWT_EXPIRES_IN=15m
AUTH_EXPOSE_DEV_TOKENS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=
SEED_CHEF_PASSWORD=
SEED_VIEWER_PASSWORD=
SEED_USERS_ONLY=false
# Read-only preview still reads Supabase and requires DATABASE_URL.
PREVIEW_MODE=false
# Supabase Storage: create a public bucket named dish-images in the dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=dish-images
# Optional integration tests: a separate, disposable PostgreSQL database/schema.
TEST_DATABASE_URL=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
RECAPTCHA_LOGIN_THRESHOLD=3
