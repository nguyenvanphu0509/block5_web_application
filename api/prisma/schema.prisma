generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("viewer")
  status       String   @default("active")
  tokenVersion Int      @default(0)
  failedLoginAttempts Int @default(0)
  captchaRequired Boolean @default(false)
  loginLockedUntil DateTime?
  chefId       Int?
  chef         Chef?    @relation(fields: [chefId], references: [id], onDelete: SetNull)
  accountTokens AccountToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime @default(now())

  @@map("users")
  @@index([chefId])
}

model AccountToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  purpose   String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("account_tokens")
}

model PasswordResetToken {
  id           Int      @id @default(autoincrement())
  userId       Int
  tokenHash    String   @unique @db.VarChar(64)
  tokenVersion Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  usedAt       DateTime? @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenVersion, createdAt])
  @@map("password_reset_tokens")
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int?
  priceIsDemo Boolean @default(false)
  recipeIsDemo Boolean @default(false)
  category    String?
  available   Boolean  @default(true)
  imagePath   String?
  priceSymbol String?
  priceLabel  String?
  priceMinVnd Int?
  priceMaxVnd Int?
  photoType   String?
  michelinUrl String?
  nameSearch String @default("")
  searchVector Unsupported("tsvector")?
  searchText  String   @default("")
  importKey   String?  @unique
  restaurantId Int?
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  chefId Int?
  chef Chef? @relation(fields: [chefId], references: [id], onDelete: SetNull)
  status String @default("published")
  ingredients DishIngredient[]
  createdAt   DateTime @default(now())

  @@map("dishes")
  @@index([restaurantId])
  @@index([chefId])
}

model Restaurant {
  id           Int      @id @default(autoincrement())
  name         String
  isDemo       Boolean @default(false)
  catalogKey   String? @unique
  address      String?
  ward         String?
  district     String?
  cuisine      String
  notableDishes String[] @default([])
  imagePath    String?
  photoType    String?
  priceMinVnd  Int?
  priceMaxVnd  Int?
  michelinUrl  String?  @unique
  searchText   String   @default("")
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  dishes       Dish[]

  @@map("restaurants")
}

model Story {
  id Int @id @default(autoincrement())
  name String
  location String
  initials String
  text String
  @@map("stories")
}

model RestaurantImportArchive {
  legacyId Int @id
  record Json
  archivedAt DateTime @default(now())
  @@map("restaurant_import_archive")
}

model Chef {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String?
  isDemo Boolean @default(false)
  catalogKey String? @unique
  dishes Dish[]
  users User[]
  createdAt DateTime @default(now())

  @@map("chefs")
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String
  isDemo Boolean @default(false)
  catalogKey String? @unique
  dishes DishIngredient[]
  createdAt DateTime @default(now())

  @@map("ingredients")
}

model DishIngredient {
  dishId Int
  ingredientId Int
  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([dishId, ingredientId])
  @@index([ingredientId])
  @@map("dish_ingredients")
}
