{
  "name": "block6-kitchen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/run-block6.js",
    "start": "node scripts/run-block6.js --production",
    "preview": "PREVIEW_MODE=true node scripts/run-block6.js",
    "db:generate": "npm --prefix api run db:generate",
    "db:push": "npm --prefix api run db:push",
    "db:seed": "npm --prefix api run db:seed",
    "db:import:michelin": "npm --prefix api run db:import:michelin",
    "db:check": "npm --prefix api run db:check",
    "test": "node --test tests/*.test.js",
    "test:db": "node --test tests/database.integration.js",
    "db:migrate:catalog": "npm --prefix api run db:migrate:catalog",
    "dev:api": "npm --prefix api run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start:api": "npm --prefix api start",
    "start:web": "npm --prefix web start",
    "test:api": "node --test tests/api.test.js",
    "test:e2e": "playwright test",
    "dev:block6": "npm run dev",
    "start:block6": "npm start",
    "dev:ssr": "npm --prefix legacy run dev",
    "start:ssr": "npm --prefix legacy start",
    "preview:ssr": "PREVIEW_MODE=true npm --prefix legacy start",
    "prestart": "npm run build",
    "test:e2e:production": "BLOCK6_PRODUCTION_TEST=true playwright test",
    "db:migrate:block7": "node api/scripts/migrate-block7.js",
    "db:seed:block7": "node api/scripts/seed-block7.js",
    "test:block7": "node --test tests/block7.integration.js",
    "test:e2e:block7": "playwright test -c playwright.block7.config.js",
    "db:prepare:block7": "node api/scripts/prepare-block7.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "workspaces": [
    "api",
    "web",
    "legacy"
  ]
}
