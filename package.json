{
  "name": "block5-kitchen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "preview": "PREVIEW_MODE=true node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:import:michelin": "node scripts/import-michelin.js",
    "db:check": "node scripts/check-db.js",
    "test": "node --test tests/*.test.js",
    "test:db": "node --test tests/database.integration.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "ejs": "3.1.10",
    "express": "5.3.0",
    "method-override": "3.0.0",
    "multer": "^2.0.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "supertest": "7.3.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
